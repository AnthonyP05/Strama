<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Strama.UI.ViewModels"
        mc:Ignorable="d"
        x:DataType="vm:MainViewModel"
        x:Class="Strama.UI.Views.MainWindow"
        Title="Strama"
        Width="900" Height="600"
        MinWidth="600" MinHeight="400">

    <Grid>
        <!-- Primary view content driven by MainViewModel.CurrentView -->
        <ContentControl Content="{Binding CurrentView}" />

        <!-- Modal overlay: settings panel -->
        <Border IsVisible="{Binding SettingsModal, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#A0000000">
            <ContentControl Content="{Binding SettingsModal}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>

        <!-- Modal overlay: incoming pair request -->
        <Border IsVisible="{Binding IncomingRequest, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#A0000000">
            <ContentControl Content="{Binding IncomingRequest}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
    </Grid>

</Window>
