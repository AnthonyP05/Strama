<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Strama.UI.ViewModels"
             x:DataType="vm:ViewingViewModel"
             x:Class="Strama.UI.Views.ViewingView">

    <Grid Background="Black">

        <!-- Full-bleed remote screen. Stretch=Uniform letterboxes if the
             aspect ratio doesn't match the window. -->
        <Image Name="StreamImage"
               Source="{Binding Renderer.Bitmap}"
               Stretch="Uniform" />

        <!-- HUD overlay (top-right): codec + dimensions + live fps. Phase 6
             will add fade-on-idle and a copy of the disconnect chrome. -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16"
                Background="#80000000"
                CornerRadius="6"
                Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Foreground="White" FontSize="12" Opacity="0.85"
                           Text="{Binding CodecLabel}" />
                <TextBlock Foreground="White" FontSize="12" Opacity="0.65" Text="·" />
                <TextBlock Foreground="White" FontSize="12" Opacity="0.85"
                           Text="{Binding SizeLabel}" />
                <TextBlock Foreground="White" FontSize="12" Opacity="0.65" Text="·" />
                <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold">
                    <Run Text="{Binding Renderer.LastFps}" />
                    <Run Text=" fps" />
                </TextBlock>
                <TextBlock Foreground="White" FontSize="12" Opacity="0.65" Text="·" />
                <TextBlock Foreground="White" FontSize="12" Opacity="0.85"
                           Text="{Binding BitrateLabel}" />
            </StackPanel>
        </Border>

        <!-- Disconnect button (top-left). Phase 6 will auto-hide it on idle. -->
        <Button Content="Disconnect"
                Command="{Binding DisconnectCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16" />

    </Grid>

</UserControl>
